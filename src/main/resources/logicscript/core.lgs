# LogicScript — datos léxicos y patrones v0.5
# Fase B: patrones semánticos elípticos compuestos (si/cuando/siempre que + y/o sin entonces).

version 0.5

# Lluvia
lemma llueve -> llover
lemma llueva -> llover
lemma llovio -> llover
lemma llovera -> llover
lemma lloveria -> llover

# Llevar (paraguas, etc.)
lemma llevo -> llevar
lemma lleva -> llevar
lemma llevas -> llevar
lemma llevan -> llevar
lemma llevara -> llevar
lemma llevaria -> llevar
lemma llevare -> llevar

# Estudiar / aprobar — irregulares en aprobar; estudiar cubierto por morfología (-ar)
lemma apruebo -> aprobar
lemma apruebas -> aprobar
lemma aprueba -> aprobar
lemma aprueban -> aprobar
lemma apruebe -> aprobar
lemma aprobo -> aprobar
lemma aprobara -> aprobar
lemma aprobare -> aprobar

# Fallar — morfología -ar; sin lemma salvo si falla en pruebas

# Trabajar / descansar — morfología -ar

# Salir — irregular
lemma salgo -> salir
lemma sales -> salir
lemma sale -> salir
lemma salen -> salir
lemma saldre -> salir
lemma saldria -> salir

# Clima / vestimenta (sustantivos + irregulares)
lemma solea -> hacer_sol
lemma hace -> hacer
lemma gorra -> gorra
lemma sombrero -> sombrero
lemma paraguas -> paraguas
lemma nieva -> nevar
lemma niegue -> nevar
lemma calor -> calor
lemma frio -> frio

# Practicar — morfología -ar

# Dormir — morfología: duermo→dormir (1ª pers.); duerme/duermes requieren lemma si fallan:
# lemma duerme -> dormir
# lemma duermes -> dormir

# Movimiento — irregulares
lemma voy -> ir
lemma vas -> ir
lemma va -> ir
lemma van -> ir
lemma ire -> ir
lemma puedo -> poder
lemma puedes -> poder
lemma quiero -> querer
lemma quieres -> querer

# Patrones semánticos (orden = prioridad de coincidencia)
pattern SI_CONJ_Y_ENTONCES si literal y literal entonces literal => imp_and left=1 mid=3 right=5
pattern SI_ENTONCES_DISY_CONS si literal entonces literal o literal => imp_or left=1 mid=3 right=5
pattern SI_ENTONCES_CONJ_CONS si literal entonces literal y literal => imp_and_cons left=1 mid=3 right=5
pattern SI_DISY_O_ENTONCES si literal o literal entonces literal => imp_or_ant left=1 mid=3 right=5
pattern SI_DISY_O_ELIPTICO si literal o literal literal => imp_or_ant left=1 mid=3 right=4
pattern SIEMPRE_QUE_CONJ_Y_ELIPTICO siempre_que literal y literal literal => imp_and left=1 mid=3 right=4
pattern SIEMPRE_QUE_DISY_O_ELIPTICO siempre_que literal o literal literal => imp_or_ant left=1 mid=3 right=4
pattern CUANDO_CONJ_Y_ELIPTICO cuando literal y literal literal => imp_and left=1 mid=3 right=4
pattern CUANDO_DISY_O_ELIPTICO cuando literal o literal literal => imp_or_ant left=1 mid=3 right=4
pattern SI_CONJ_Y_ELIPTICO si literal y literal literal => imp_and left=1 mid=3 right=4
pattern SI_ENTONCES si literal entonces literal => imp left=1 right=3
pattern SI_ELIPTICO si literal literal => imp left=1 right=2
pattern CUANDO_ENTONCES cuando literal entonces literal => imp left=1 right=3
pattern CUANDO_ELIPTICO cuando literal literal => imp left=1 right=2
pattern SOLO_SI literal solo_si literal => imp left=0 right=2
pattern A_MENOS_QUE literal a_menos_que literal => imp_unless left=0 right=2
pattern SIEMPRE_QUE_ENTONCES siempre_que literal entonces literal => imp left=1 right=3
pattern SIEMPRE_QUE_ELIPTICO siempre_que literal literal => imp left=1 right=2
pattern CONSECUENTE_SI_ANTECEDENTE literal si literal => imp left=2 right=0
pattern EN_CASO_DE_QUE en_caso_de_que literal literal => imp left=1 right=2
pattern EQUIVALENCIA literal si_y_solo_si literal => equiv left=0 right=2
pattern CONJUNCION literal y literal => and left=0 right=2
pattern DISYUNCION literal o literal => or left=0 right=2
